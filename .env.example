# Copy to .env and replace with a key from Google AI Studio.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Required for npm run eval. Choose the highest-capability Gemini model
# available to your project for more capable judging; it can cost more.
GEMINI_JUDGE_MODEL=replace-with-your-selected-gemini-judge-model
